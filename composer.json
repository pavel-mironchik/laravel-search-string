{
    "name": "libre-accounting/laravel-search-string",
    "description": "Generates database queries based on one unique string using a simple and customizable syntax. (Libre Accounting fork of lorisleiva/laravel-search-string with Laravel 11+ support)",
    "homepage": "https://github.com/libre-accounting/laravel-search-string",
    "license": "MIT",
    "authors": [
        {
            "name": "Loris Leiva",
            "email": "loris.leiva@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "hoa/compiler": "^3.17",
        "sanmai/hoa-protocol": "^1.17"
    },
    "replace": {
        "lorisleiva/laravel-search-string": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Lorisleiva\\LaravelSearchString\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lorisleiva\\LaravelSearchString\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lorisleiva\\LaravelSearchString\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library"
}
