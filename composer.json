{
    "name": "flashasia/laravel-search-string",
    "description": "Maintained native-compiler fork of Laravel Search String",
    "license": "MIT",
    "authors": [
        {
            "name": "Loris Leiva",
            "email": "loris.leiva@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0"
    },
    "replace": {
        "lorisleiva/laravel-search-string": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "orchestra/testbench": "^8.0|^9.0"
    },
    "autoload": {
        "psr-4": {
            "Lorisleiva\\LaravelSearchString\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lorisleiva\\LaravelSearchString\\Tests\\": "tests"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lorisleiva\\LaravelSearchString\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "type": "library"
}
